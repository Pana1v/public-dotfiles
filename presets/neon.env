# Work machine in the neon orange look: professional modules, palette preselected,
# no centre clock (CET time sits in the top panel, cet-clock extension).
DESC="Neon orange work desktop: neon palette, dot-matrix wings, fleet + Linear deck"
PROFILE="professional"
CONKY_WIDGETS="wings deck"
RICE_THEME="neon"
MODULES="apt-repos apps-dev apps-desktop browsers claude cli-tools conky cursor fonts-cursors git gnome gnome-extensions rice secrets shell skills spotify ssh terminator tmux vscode"
