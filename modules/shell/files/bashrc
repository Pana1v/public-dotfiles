# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac
[ -f ~/.local/share/blesh/ble.sh ] && source ~/.local/share/blesh/ble.sh --noattach

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# Up-arrow history (atuin owns Ctrl-R). Large, timestamped, shared across panes:
# history -a appends each command as it runs, so a new pane sees it at once.
HISTSIZE=50000
HISTFILESIZE=100000
HISTTIMEFORMAT='%F %T  '
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# ** matches nested dirs (ls src/**/CMakeLists.txt); cd fixes small typos.
shopt -s globstar cdspell dirspell

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	# We have color support; assume it's compliant with Ecma-48
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

export PATH="$HOME/.local/bin:$PATH"

export PATH="$HOME/.pixi/bin:$PATH"
command -v xhost >/dev/null && xhost +local:docker >/dev/null


# Linear API key for daily-report MCP
[ -f ~/.config/secrets/linear.env ] && . ~/.config/secrets/linear.env

# GitHub PAT for gh CLI and daily-report
[ -f ~/.config/secrets/github.env ] && . ~/.config/secrets/github.env

export LANG=en_IN.UTF-8
export LANGUAGE=en_IN:en
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
alias amr='make -C $HOME/amr_launch_scripts'

export NVM_DIR="$HOME/.nvm"
# Sourcing nvm.sh costs ~0.3s per shell and is wasted in any shell that never
# touches node. Stub the entry points and load nvm on first actual use.
_nvm_lazy_load() {
    unset -f nvm node npm npx _nvm_lazy_load
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
}
for _nvm_cmd in nvm node npm npx; do
    eval "${_nvm_cmd}() { _nvm_lazy_load; ${_nvm_cmd} \"\$@\"; }"
done
unset _nvm_cmd
export XCURSOR_THEME=oreo-pink-cursors

# AMR status banner - system stats + launch sessions (added by setup.sh)
# Set AMR_BANNER=0 to suppress it.
alias amr-status='bash $HOME/amr-docker/scripts/amr_status.sh'
# Backgrounded in a subshell so the prompt is not blocked (~0.3s) and bash
# prints no job-control notice. Output lands a moment after the prompt.
[ -f "$HOME/amr-docker/scripts/amr_status.sh" ] && ( bash "$HOME/amr-docker/scripts/amr_status.sh" --banner & )

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

command -v starship >/dev/null && eval "$(starship init bash)"
[ -f ~/.config/fzf-tokyonight.sh ] && . ~/.config/fzf-tokyonight.sh
# fzf keys: Ctrl-T files, Alt-C cd. Loaded before cli-tools so atuin keeps Ctrl-R.
command -v fzf >/dev/null && eval "$(fzf --bash 2>/dev/null)"

[ -f ~/.config/bash/cli-tools.bash ] && . ~/.config/bash/cli-tools.bash
# Startup HUD (~/.config/bash/banner.py), at any width; fastfetch if it is missing.
if [[ $- == *i* ]]; then
  if [ -f ~/.config/bash/banner.py ]; then
    python3 ~/.config/bash/banner.py
  elif command -v fastfetch >/dev/null; then fastfetch
  elif command -v neofetch >/dev/null; then neofetch; fi
fi

# Private aliases and work helpers, from the private repo when checked out.
# The AMR Docker aliases (added by setup.sh) live there; this line keeps the
# marker so setup.sh does not append them here again.
[ -f "$HOME/.config/dotfiles/private/shell/bashrc.private" ] && . "$HOME/.config/dotfiles/private/shell/bashrc.private"

[[ ! ${BLE_VERSION-} ]] || ble-attach
