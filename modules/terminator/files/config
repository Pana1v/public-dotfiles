[global_config]
  handle_size = 2
  inactive_color_offset = 0.88
  enabled_plugins = ActivityWatch, InactivityWatch, TerminalShot, Logger, CustomCommandsMenu, PyTracebackHandler, PathLineHandler, LinearIssueHandler
  cell_height = 1.1
[keybindings]
  switch_to_tab_1 = <Alt>1
  switch_to_tab_2 = <Alt>2
  switch_to_tab_3 = <Alt>3
  switch_to_tab_4 = <Alt>4
  switch_to_tab_5 = <Alt>5
  switch_to_tab_6 = <Alt>6
  switch_to_tab_7 = <Alt>7
  switch_to_tab_8 = <Alt>8
  switch_to_tab_9 = <Alt>9
  broadcast_off = <Shift><Control>m
  broadcast_all = <Shift><Control>b
[profiles]
  [[default]]
    background_color = "#5a1a24"
    background_darkness = 0.35
    background_type = transparent
    cursor_blink = False
    cursor_shape = ibeam
    cursor_fg_color = "#0a0506"
    cursor_bg_color = "#ffffff"
    cursor_color_default = False
    font = JetBrains Mono 11
    foreground_color = "#ffffff"
    scrollbar_position = hidden
    scrollback_lines = 50000
    palette = "#020101:#ff3b1f:#52e5ff:#ffc14d:#ff1f3d:#ff1f3d:#ff3b1f:#e6e6e6:#5e1f25:#ff3b1f:#52e5ff:#ffc14d:#ff1f3d:#ff1f3d:#ff3b1f:#ffffff"
    use_system_font = False
    copy_on_selection = True
    title_hide_sizetext = True
    title_transmit_fg_color = "#050203"
    title_transmit_bg_color = "#ff1f3d"
    title_receive_fg_color = "#050203"
    title_receive_bg_color = "#52e5ff"
    title_inactive_fg_color = "#73303a"
    title_inactive_bg_color = "#2a1013"
    title_use_system_font = False
    title_font = JetBrains Mono 9
