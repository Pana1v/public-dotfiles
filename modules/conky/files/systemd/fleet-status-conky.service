[Unit]
Description=Fleet Status Conky (ping sweep panel)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.config/conky/Common/start-widget.sh %h/.config/conky/FleetStatus/fleet_widget.conf
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
