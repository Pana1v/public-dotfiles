{
    "github.copilot.nextEditSuggestions.enabled": true,
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "workbench.colorTheme": "Interstellar",
    "editor.fontFamily": "'JetBrains Mono', 'Symbols Nerd Font Mono', monospace",
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "'JetBrains Mono', 'Symbols Nerd Font Mono'",
    "terminal.integrated.cursorStyle": "line",
    "security.promptForLocalFileProtocolHandling": false,
    "security.promptForRemoteFileProtocolHandling": false,
    "animations.Install-Method": "Apc Customize UI++",
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "claudeCode.preferredLocation": "panel",
    "terminal.integrated.commandsToSkipShell": [
        "kilo-code.new.agentManagerOpen",
        "kilo-code.new.agentManager.showTerminal",
        "kilo-code.new.agentManager.previousTerminal",
        "kilo-code.new.agentManager.nextTerminal"
    ],
    "gitlens.graph.details.location": "auto"
}
