# ble.sh: Tokyo Night faces for syntax highlighting and inline suggestions.
bleopt term_true_colors=semicolon
bleopt complete_auto_delay=100

ble-face -s auto_complete           fg=#9e2228,italic
ble-face -s syntax_command          fg=#d10a10
ble-face -s command_builtin         fg=#ff3d6b
ble-face -s command_alias           fg=#ff3b3b
ble-face -s command_function        fg=#ff3b3b
ble-face -s command_file            fg=#d10a10
ble-face -s syntax_error            fg=#ff1a1a,bold
ble-face -s syntax_quoted           fg=#ff7070
ble-face -s syntax_quotation        fg=#ff7070
ble-face -s syntax_varname          fg=#ffb84a
ble-face -s syntax_param_expansion  fg=#ffb84a
ble-face -s syntax_comment          fg=#9e2228
ble-face -s filename_directory      fg=#d10a10,underline
ble-face -s region_insert           bg=#2a0c0e
ble-face -s region                  bg=#4a0f12
