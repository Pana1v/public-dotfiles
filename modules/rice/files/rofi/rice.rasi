/* Rice launcher, drawn as one of the conky cards (modules/conky Common/flat.lua):
   near-black tinted card, 18px corners, Space Mono caps header with a red
   section number, dot-matrix (Doto) numerals, dotted rules, red only for
   what is lit. Hexes are palette roles so switch-theme.sh recolours them.

     01 APPS                                         12 / 240
     > search
     . . . . . . . . . . . . . . . . . . . . . . . . . . . .
     icon  Brave                                 (lit row)
     icon  Files
     . . . . . . . . . . . . . . . . . . . . . . . . . . . .
     APPS  WINDOWS  RUN  CALC  FILES  KEYS  POWER    ESC
*/
* {
    card:      #120506ff;
    plate:     #180708;
    unlit:     #4a0f12;
    fg:        #f5f5f5;
    soft:      #fff4f5;
    faint:     #b6b6b6;
    dim:       #8e8e8e;
    accent:    #ec0b12;
    ok:        #e8e8e8;
    bad:       #ff1a1a;

    background-color: transparent;
    text-color:       @fg;
    border-color:     @unlit;
    spacing:          0;
    font:             "Space Mono 10";
}

window {
    location:         center;
    anchor:           center;
    width:            680px;
    background-color: @card;
    border:           1px;
    border-color:     #2a0c0e;
    border-radius:    18px;
    padding:          18px 20px 14px 20px;
}

mainbox {
    children: [ header, inputbar, message, listview, footer ];
    spacing:  0;
}

/* ── Header: 01 MODE ................................ 12 / 240 ── */
header {
    orientation: horizontal;
    expand:      false;
    children:    [ textbox-no, prompt, textbox-fill, num-filtered-rows, textbox-sep, num-rows ];
    spacing:     9px;
    padding:     0 0 10px 0;
}
textbox-no {
    str:            "01";
    expand:         false;
    vertical-align: 1.0;
    font:           "Space Mono 12";
    text-color:     @accent;
}
prompt {
    vertical-align: 1.0;
    font:           "Space Mono Bold 12";
    text-color:     @fg;
}
textbox-fill {
    str:    "";
    expand: true;
}
num-filtered-rows,
num-rows {
    vertical-align: 1.0;
    font:           "Doto Black 13";
    text-color:     @fg;
}
num-rows { text-color: @dim; }
textbox-sep {
    str:            "/";
    expand:         false;
    vertical-align: 1.0;
    font:           "Space Mono 10";
    text-color:     @faint;
}

/* ── Search line, closed by a dotted rule like the conky hline ── */
inputbar {
    children:  [ textbox-caret, entry, case-indicator ];
    spacing:   10px;
    padding:   8px 2px 12px 2px;
    border:    0 0 2px dash 0;
    border-color: @unlit;
}
textbox-caret {
    str:            "󰅂";
    font:           "Symbols Nerd Font Mono 13";
    vertical-align: 0.5;
    expand:         false;
    text-color:     @accent;
}
entry {
    vertical-align:    0.5;
    font:              "Space Mono 12";
    text-color:        @fg;
    cursor:            text;
    placeholder:       "search";
    placeholder-color: @dim;
}
case-indicator {
    vertical-align: 0.5;
    text-color:     @faint;
}

/* Calc results, script notices and errors: a plate with a red edge. */
message {
    margin:           10px 0 0 0;
    padding:          8px 12px;
    background-color: @plate;
    border:           0 0 0 2px;
    border-color:     @accent;
    border-radius:    12px;
}
textbox { text-color: @soft; }

/* ── Rows ── */
listview {
    lines:        8;
    columns:      1;
    cycle:        true;
    dynamic:      true;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
    padding:      10px 0;
}

/* Unlit rows are plain text; the lit row gets a plate, white text and a
   red edge like the selected conky row. */
element {
    padding:       8px 14px;
    spacing:       14px;
    border:        1px;
    border-color:  transparent;
    border-radius: 10px;
}
element-icon {
    size:           24px;
    vertical-align: 0.5;
}
element-text {
    vertical-align: 0.5;
    highlight:      bold #ec0b12;
    text-color:     inherit;
}
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @faint;
}
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @ok;
}
element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @bad;
}
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @plate;
    border-color:     @accent;
    text-color:       @fg;
}
element selected.urgent { text-color: @bad; }

/* ── Footer: modes as a status line, dotted rule above ── */
footer {
    orientation: horizontal;
    expand:      false;
    children:    [ mode-switcher, textbox-hint ];
    padding:     10px 2px 0 2px;
    border:      2px dash 0 0 0;
    border-color: @unlit;
}
mode-switcher {
    spacing: 14px;
    expand:  true;
}
button {
    expand:     false;
    padding:    0;
    font:       "Space Mono Bold 9";
    text-color: @dim;
}
button selected {
    text-color: @accent;
}
textbox-hint {
    str:            "TAB  MODE    ESC  CLOSE";
    expand:         false;
    vertical-align: 0.5;
    font:           "Space Mono 9";
    text-color:     @dim;
}
