{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "padding": { "top": 1, "right": 3 }
  },

  "display": {
    // iec = GiB (1024-based). RAM and disk are sold/reported in these units,
    // so SI GB would show 66.81 for a 64 GiB stick and read as wrong.
    "size": { "binaryPrefix": "iec" },
    "key": { "width": 11 },
    "separator": "  ",
    "color": { "keys": "blue", "separator": "90" },
    "percent": { "type": ["bar", "num"] },
    "bar": { "char": { "elapsed": "=", "total": "-" }, "width": 12 }
  },

  "modules": [
    "break",
    { "type": "title", "format": "{#1;35}{user-name}{#}@{#1;34}{host-name}{#}" },
    { "type": "separator", "string": "─" },

    { "type": "os",       "key": "os" },
    { "type": "host",     "key": "machine" },
    { "type": "kernel",   "key": "kernel", "format": "{release}" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "packages", "key": "packages" },
    { "type": "shell",    "key": "shell" },
    { "type": "terminal", "key": "term" },

    "break",
    { "type": "de",      "key": "desktop" },
    { "type": "wm",      "key": "wm" },
    { "type": "theme",   "key": "theme" },
    { "type": "display", "key": "screen", "compactType": "original-with-refresh-rate" },

    "break",
    { "type": "cpu", "key": "cpu", "showPeCoreCount": true, "temp": true },

    // driverSpecific queries NVML instead of the pci.ids lookup table. The
    // shipped pci.ids (Mar 2025) has no entry for PCI id 2d39, so without this
    // the Blackwell card renders as "NVIDIA Device 2D39". NVML also gives
    // clock, temperature and live VRAM use.
    { "type": "gpu", "key": "gpu", "driverSpecific": true, "temp": true },

    { "type": "memory",  "key": "ram" },
    { "type": "swap",    "key": "swap" },
    { "type": "disk",    "key": "disk", "folders": "/" },
    { "type": "battery", "key": "battery" },

    "break",
    { "type": "localip",  "key": "net", "showIpv4": true, "showPrefixLen": false },
    { "type": "datetime", "key": "time",
      "format": "{weekday-short} {day-pretty} {month-name-short} {year}, {hour-pretty}:{minute-pretty}" },

    "break",
    { "type": "colors", "symbol": "circle" },
    "break"
  ]
}
