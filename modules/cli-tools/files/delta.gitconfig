[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	# Ares bat theme (cli-tools/files/bat) plus palette diff tints.
	syntax-theme = Ares
	minus-style = syntax "#3a0a0e"
	minus-non-emph-style = syntax "#240709"
	minus-emph-style = syntax "#6b1219"
	minus-empty-line-marker-style = normal "#3a0a0e"
	plus-style = syntax "#2a1c08"
	plus-non-emph-style = syntax "#1c1205"
	plus-emph-style = syntax "#57390f"
	plus-empty-line-marker-style = normal "#2a1c08"
	line-numbers-minus-style = "#ff1a1a"
	line-numbers-plus-style = "#ff7070"
	line-numbers-zero-style = "#641418"
	line-numbers-left-style = "#2a0c0e"
	line-numbers-right-style = "#2a0c0e"
	file-style = bold "#d10a10"
	file-decoration-style = "#d10a10" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#641418" box
	hunk-header-file-style = "#ff3b3b"
	hunk-header-line-number-style = "#ffb84a"
	commit-decoration-style = "#d10a10" box
	blame-palette = "#0a0303 #180708 #2a0c0e"
	whitespace-error-style = "#ff1a1a" reverse
[merge]
	conflictStyle = zdiff3
