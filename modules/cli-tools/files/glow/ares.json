{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#f2c4c8", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#b86a72", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#ff1f3d", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#050203", "background_color": "#ff1f3d", "bold": true },
  "h2": { "prefix": "## ", "color": "#ff1f3d" },
  "h3": { "prefix": "### ", "color": "#ff6b7d" },
  "h4": { "prefix": "#### ", "color": "#ff4f8b" },
  "h5": { "prefix": "##### ", "color": "#ffa3b0" },
  "h6": { "prefix": "###### ", "color": "#b86a72", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true, "color": "#8a3a44" },
  "emph": { "italic": true, "color": "#ffe9eb" },
  "strong": { "bold": true, "color": "#ffe9eb" },
  "hr": { "color": "#5e1f25", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". ", "color": "#ff1f3d" },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#ff6b7d", "underline": true },
  "link_text": { "color": "#ff1f3d", "bold": true },
  "image": { "color": "#ff6b7d", "underline": true },
  "image_text": { "color": "#b86a72", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#ffa3b0", "background_color": "#1a0b0d" },
  "code_block": {
    "color": "#f2c4c8",
    "margin": 2,
    "chroma": {
      "text": { "color": "#ffe9eb" },
      "error": { "color": "#ff3b1f", "background_color": "#3a0a0e" },
      "comment": { "color": "#8a3a44", "italic": true },
      "comment_preproc": { "color": "#ff4f8b" },
      "keyword": { "color": "#ff1f3d" },
      "keyword_reserved": { "color": "#ff1f3d" },
      "keyword_namespace": { "color": "#ff1f3d" },
      "keyword_type": { "color": "#ffc14d" },
      "operator": { "color": "#ff6b7d" },
      "punctuation": { "color": "#b86a72" },
      "name": { "color": "#ffe9eb" },
      "name_builtin": { "color": "#ff6b7d" },
      "name_tag": { "color": "#ff1f3d" },
      "name_attribute": { "color": "#ffc14d" },
      "name_class": { "color": "#ffc14d", "bold": true },
      "name_constant": { "color": "#ff7a29" },
      "name_decorator": { "color": "#ff4f8b" },
      "name_exception": { "color": "#ff3b1f" },
      "name_function": { "color": "#ff6b7d" },
      "name_other": { "color": "#f2c4c8" },
      "literal": { "color": "#ff7a29" },
      "literal_number": { "color": "#ff7a29" },
      "literal_date": { "color": "#ff7a29" },
      "literal_string": { "color": "#ffa3b0" },
      "literal_string_escape": { "color": "#ff4f8b" },
      "generic_deleted": { "color": "#ff3b1f" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#52e5ff" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#ff6b7d" },
      "background": { "background_color": "#1a0b0d" }
    }
  },
  "table": { "color": "#f2c4c8" },
  "definition_list": {},
  "definition_term": { "color": "#ff1f3d" },
  "definition_description": { "block_prefix": "\n→ " },
  "html_block": { "color": "#8a3a44" },
  "html_span": { "color": "#8a3a44" }
}
