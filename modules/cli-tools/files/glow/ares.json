{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#f5c6c6", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#c8454a", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#d10a10", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#060101", "background_color": "#d10a10", "bold": true },
  "h2": { "prefix": "## ", "color": "#d10a10" },
  "h3": { "prefix": "### ", "color": "#ff3b3b" },
  "h4": { "prefix": "#### ", "color": "#ff3d6b" },
  "h5": { "prefix": "##### ", "color": "#ff9a9a" },
  "h6": { "prefix": "###### ", "color": "#c8454a", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true, "color": "#9e2228" },
  "emph": { "italic": true, "color": "#ffe9e9" },
  "strong": { "bold": true, "color": "#ffe9e9" },
  "hr": { "color": "#641418", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". ", "color": "#d10a10" },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#ff3b3b", "underline": true },
  "link_text": { "color": "#d10a10", "bold": true },
  "image": { "color": "#ff3b3b", "underline": true },
  "image_text": { "color": "#c8454a", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#ff9a9a", "background_color": "#180708" },
  "code_block": {
    "color": "#f5c6c6",
    "margin": 2,
    "chroma": {
      "text": { "color": "#ffe9e9" },
      "error": { "color": "#ff1a1a", "background_color": "#3a0a0e" },
      "comment": { "color": "#9e2228", "italic": true },
      "comment_preproc": { "color": "#ff3d6b" },
      "keyword": { "color": "#d10a10" },
      "keyword_reserved": { "color": "#d10a10" },
      "keyword_namespace": { "color": "#d10a10" },
      "keyword_type": { "color": "#ffb84a" },
      "operator": { "color": "#ff3b3b" },
      "punctuation": { "color": "#c8454a" },
      "name": { "color": "#ffe9e9" },
      "name_builtin": { "color": "#ff3b3b" },
      "name_tag": { "color": "#d10a10" },
      "name_attribute": { "color": "#ffb84a" },
      "name_class": { "color": "#ffb84a", "bold": true },
      "name_constant": { "color": "#ff7a3d" },
      "name_decorator": { "color": "#ff3d6b" },
      "name_exception": { "color": "#ff1a1a" },
      "name_function": { "color": "#ff3b3b" },
      "name_other": { "color": "#f5c6c6" },
      "literal": { "color": "#ff7a3d" },
      "literal_number": { "color": "#ff7a3d" },
      "literal_date": { "color": "#ff7a3d" },
      "literal_string": { "color": "#ff9a9a" },
      "literal_string_escape": { "color": "#ff3d6b" },
      "generic_deleted": { "color": "#ff1a1a" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#ff7070" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#ff3b3b" },
      "background": { "background_color": "#180708" }
    }
  },
  "table": { "color": "#f5c6c6" },
  "definition_list": {},
  "definition_term": { "color": "#d10a10" },
  "definition_description": { "block_prefix": "\n→ " },
  "html_block": { "color": "#9e2228" },
  "html_span": { "color": "#9e2228" }
}
